benchmarks/scaled_evals/results/

# Onyx benchmark integration — PAUSED, not yet verified against a live
# instance (see plans/onyx-integration.md). Excluded wholesale from git for
# now so main stays clean of unverified work; will be pushed to a dedicated
# feature branch once resumed and verified, not merged to main until then.
# This ignores the feature's own code too, not just its runtime artifacts —
# a broader exclusion than this project's other benchmark-layer entries below.
benchmarks/scaled_evals/agents/onyx_target/
benchmarks/scaled_evals/datasets/prepare_onyx_upload.py
benchmarks/scaled_evals/datasets/onyx_upload_payloads.jsonl
benchmarks/scaled_evals/datasets/onyx_upload_state.json
scripts/run_onyx_benchmark.py
docs/testing_your_own_onyx_deployment.md
tests/test_onyx_connector.py
tests/test_prepare_onyx_upload.py
